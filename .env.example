# Copy to .env and replace every required placeholder before deployment.
POSTGRES_DB=ganlan_gold
POSTGRES_USER=ganlan
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
DATABASE_URL=postgresql://ganlan:replace-with-url-encoded-password@db:5432/ganlan_gold

# Public deployment identity. Use http://localhost only for local Docker work.
NEXT_PUBLIC_SITE_URL=http://localhost
SITE_ADDRESS=http://localhost
HTTP_PORT=80
HTTPS_PORT=443

# Generate independent random values of at least 32 characters.
RATE_LIMIT_SECRET=replace-with-an-independent-random-value
SUBMISSION_FINGERPRINT_SECRET=replace-with-an-independent-random-value
PRIVACY_HASH_SECRET=replace-with-an-independent-random-value
CRON_SECRET=replace-with-an-independent-random-value
RATE_REFRESH_INTERVAL_SECONDS=86400
TRUST_PROXY=true

# Optional SMTP notification transport. Leave all optional values blank to disable email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
LEAD_NOTIFICATION_TO=

# Used only with `docker compose run --rm migrate admin-init`; never consumed automatically.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
