# OPTIONAL public EmailJS browser identifiers; the site builds with all values empty.
# A deliberate public/config/emailjs.json takes priority. See docs/EMAILJS_OPTIONAL_CONFIGURATION.md.
# Never add an EmailJS private key or email-provider password here.
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_QUOTE_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_VISIT_TEMPLATE_ID=
