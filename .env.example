# Public EmailJS browser identifiers; configure actual values in .env.local.
# Never add an EmailJS private key or email-provider password here.
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=YOUR_PUBLIC_KEY
NEXT_PUBLIC_EMAILJS_SERVICE_ID=YOUR_SERVICE_ID
NEXT_PUBLIC_EMAILJS_QUOTE_TEMPLATE_ID=YOUR_QUOTE_TEMPLATE_ID
NEXT_PUBLIC_EMAILJS_VISIT_TEMPLATE_ID=YOUR_VISIT_TEMPLATE_ID
