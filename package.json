{
  "name": "ganlan-gold-static",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/copy-out-to-dist.mjs && tsx scripts/check-dist.mjs",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test tests/e2e/public.spec.ts tests/e2e/forms.spec.ts tests/e2e/prices.spec.ts tests/e2e/release.spec.ts tests/e2e/olive.spec.ts tests/e2e/experience3d.spec.ts",
    "preview": "npx serve dist",
    "verify:static": "tsx scripts/check-dist.mjs",
    "test": "tsx --test tests/unit/*.test.ts && npm run verify:emailjs",
    "verify:emailjs": "tsx scripts/validate-emailjs-templates.ts",
    "build:preview": "npm run build",
    "preview:emailjs": "tsx scripts/validate-emailjs-templates.ts --previews"
  },
  "dependencies": {
    "@emailjs/browser": "^5.0.3",
    "lucide-react": "1.61.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "6.0.3"
  }
}
