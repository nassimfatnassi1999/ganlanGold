generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AdminRole {
  ADMIN
}

enum QuoteStatus {
  NEW
  CONTACTED
  IN_NEGOTIATION
  QUOTED
  CLOSED
}

enum VisitStatus {
  NEW
  CONTACTED
  SCHEDULED
  COMPLETED
  CLOSED
  DECLINED
}

enum NotificationStatus {
  NOT_CONFIGURED
  PENDING
  SENT
  FAILED
}

enum ExchangeRateStatus {
  VALID
  FAILED
}

model AdminUser {
  id           String         @id @default(uuid()) @db.Uuid
  email        String         @unique @db.VarChar(320)
  passwordHash String         @db.VarChar(255)
  role         AdminRole      @default(ADMIN)
  active       Boolean        @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  sessions     AdminSession[]
  auditLogs    AuditLog[]
}

model AdminSession {
  id            String    @id @default(uuid()) @db.Uuid
  tokenHash     String    @unique @db.Char(64)
  userId        String    @db.Uuid
  expiresAt     DateTime
  idleExpiresAt DateTime
  lastSeenAt    DateTime  @default(now())
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())
  user          AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model Product {
  id             String               @id @db.VarChar(16)
  slug           String               @unique @db.VarChar(32)
  capacityMl     Int
  capacityLitres Decimal              @db.Decimal(8, 3)
  usdPrice       Decimal              @db.Decimal(10, 2)
  imagePath      String               @db.VarChar(255)
  displayOrder   Int                  @unique
  professional   Boolean              @default(false)
  active         Boolean              @default(true)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  translations   ProductTranslation[]
  quoteItems     QuoteRequestItem[]
}

model ProductTranslation {
  productId   String   @db.VarChar(16)
  locale      String   @db.VarChar(10)
  name        String   @db.VarChar(120)
  description String   @db.Text
  label       String   @db.VarChar(180)
  approvedAt  DateTime?
  updatedAt   DateTime @updatedAt
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, locale])
  @@index([locale])
}

model QuoteRequest {
  id                    String             @id @default(uuid()) @db.Uuid
  requestId             String             @unique @db.VarChar(40)
  company               String             @db.VarChar(200)
  country               String             @db.VarChar(120)
  contactPerson         String             @db.VarChar(160)
  email                 String?            @db.VarChar(320)
  wechat                String?            @db.VarChar(160)
  destinationPort       String             @db.VarChar(180)
  message               String?            @db.Text
  totalLitres           Decimal            @db.Decimal(14, 3)
  belowMinimum          Boolean
  consentAt             DateTime
  consentText           String             @db.Text
  consentVersion        String             @db.VarChar(32)
  status                QuoteStatus        @default(NEW)
  internalNotes         String?            @db.Text
  submissionFingerprint String             @unique @db.Char(64)
  ipHash                String?            @db.Char(64)
  notificationStatus    NotificationStatus @default(PENDING)
  notificationError     String?            @db.VarChar(500)
  submittedAt           DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  items                 QuoteRequestItem[]

  @@index([status, submittedAt])
  @@index([company])
  @@index([country])
}

model QuoteRequestItem {
  id                    String       @id @default(uuid()) @db.Uuid
  quoteRequestId        String       @db.Uuid
  productId             String       @db.VarChar(16)
  quantity              Int
  capacityLitres        Decimal      @db.Decimal(8, 3)
  usdReferencePrice     Decimal      @db.Decimal(10, 2)
  requestedVolumeLitres Decimal      @db.Decimal(14, 3)
  quoteRequest          QuoteRequest @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  product               Product      @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([quoteRequestId, productId])
  @@index([productId])
}

model VisitRequest {
  id                    String             @id @default(uuid()) @db.Uuid
  requestId             String             @unique @db.VarChar(40)
  company               String             @db.VarChar(200)
  contactPerson         String             @db.VarChar(160)
  country               String             @db.VarChar(120)
  contact               String             @db.VarChar(320)
  preferredPeriod       String             @db.VarChar(180)
  visitors              Int?
  message               String?            @db.Text
  consentAt             DateTime
  consentText           String             @db.Text
  consentVersion        String             @db.VarChar(32)
  status                VisitStatus        @default(NEW)
  internalNotes         String?            @db.Text
  submissionFingerprint String             @unique @db.Char(64)
  ipHash                String?            @db.Char(64)
  notificationStatus    NotificationStatus @default(PENDING)
  notificationError     String?            @db.VarChar(500)
  submittedAt           DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@index([status, submittedAt])
  @@index([company])
}

model ExchangeRate {
  id            String             @id @default(uuid()) @db.Uuid
  source        String             @default("ECB") @db.VarChar(32)
  status        ExchangeRateStatus
  eurUsd        Decimal?           @db.Decimal(18, 8)
  eurCny        Decimal?           @db.Decimal(18, 8)
  usdCny        Decimal?           @db.Decimal(18, 8)
  referenceDate DateTime?          @db.Date
  attemptedAt   DateTime           @default(now())
  errorCode     String?            @db.VarChar(80)
  errorMessage  String?            @db.VarChar(500)

  @@index([status, referenceDate])
  @@index([attemptedAt])
}

model SiteSetting {
  key         String   @id @db.VarChar(120)
  value       Json
  locked      Boolean  @default(false)
  updatedById String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id         String     @id @default(uuid()) @db.Uuid
  actorId    String?    @db.Uuid
  action     String     @db.VarChar(100)
  entityType String     @db.VarChar(80)
  entityId   String?    @db.VarChar(120)
  before     Json?
  after      Json?
  ipHash     String?    @db.Char(64)
  createdAt  DateTime   @default(now())
  actor      AdminUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([createdAt])
}

model RateLimitBucket {
  id          String   @id @default(uuid()) @db.Uuid
  scope       String   @db.VarChar(80)
  keyHash     String   @db.Char(64)
  windowStart DateTime
  count       Int      @default(1)
  updatedAt   DateTime @updatedAt

  @@unique([scope, keyHash, windowStart])
  @@index([windowStart])
}
